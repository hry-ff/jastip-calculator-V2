<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jastip Apip 🍁</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="bg-slate-100 min-h-screen text-slate-800 p-4 md:p-8">

    <div class="max-w-4xl mx-auto space-y-6">
        <!-- Header -->
        <header class="bg-emerald-700 text-white rounded-2xl p-6 shadow-lg flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
            <div>
                <h1 class="text-2xl font-bold flex items-center gap-2">
                    <i class="fa-solid fa-calculator"></i> Jastip Apip 🍁
                </h1>
                <p class="text-emerald-100 text-sm mt-1">South Korea (KRW) to Indonesia (IDR)</p>
            </div>
            <div class="bg-emerald-800/80 backdrop-blur rounded-xl p-3 border border-emerald-600/50 flex items-center gap-3 text-sm">
                <div>
                    <label class="block text-xs text-emerald-200">Exchange Rate (1 KRW)</label>
                    <div class="font-semibold flex items-center gap-1">
                        <span>Rp</span>
                        <input type="number" id="exchangeRateInput" value="13.6" step="0.1" class="w-16 bg-emerald-900/60 border border-emerald-500 rounded px-1.5 py-0.5 text-white font-bold text-center focus:outline-none">
                    </div>
                </div>
            </div>
        </header>

        <!-- Base Fee Card -->
        <div class="bg-white rounded-2xl p-4 shadow-sm border border-slate-200 flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-lg">
                    <i class="fa-solid fa-receipt"></i>
                </div>
                <div>
                    <h3 class="font-semibold text-slate-800">Customer Base Fee</h3>
                    <p class="text-xs text-slate-500">Flat service fee applied once per customer order</p>
                </div>
            </div>
            <div class="flex items-center gap-2 font-medium">
                <span class="text-slate-500">Rp</span>
                <input type="number" id="baseFeeInput" value="20000" step="1000" class="w-28 border border-slate-300 rounded-lg px-3 py-1.5 text-slate-800 font-bold focus:ring-2 focus:ring-emerald-500 focus:outline-none">
            </div>
        </div>

        <!-- Items Container -->
        <div id="itemsContainer" class="space-y-4"></div>

        <!-- Action Buttons -->
        <div class="flex gap-3">
            <button onclick="addItem()" class="flex-1 bg-slate-200 hover:bg-slate-300 text-slate-800 font-semibold py-3 px-4 rounded-xl border border-slate-300 transition flex items-center justify-center gap-2">
                <i class="fa-solid fa-plus text-emerald-600"></i> Add Another Item
            </button>
        </div>

        <!-- Order Summary Footer -->
        <div class="bg-white rounded-2xl p-6 shadow-md border border-slate-200 space-y-4">
            <h2 class="text-lg font-bold text-slate-800 border-b border-slate-100 pb-3 flex items-center gap-2">
                <i class="fa-solid fa-file-invoice-dollar text-emerald-600"></i> Order Summary
            </h2>

            <div class="space-y-2 text-sm">
                <div class="flex justify-between text-slate-600">
                    <span>Subtotal Items (<span id="summaryItemCount">0</span>)</span>
                    <span id="summaryItemsTotal" class="font-semibold">Rp 0</span>
                </div>
                <div class="flex justify-between text-slate-600">
                    <span>Customer Base Fee</span>
                    <span id="summaryBaseFee" class="font-semibold">Rp 30,000</span>
                </div>
                <div class="border-t border-slate-200 pt-3 flex justify-between items-center">
                    <span class="text-base font-bold text-slate-800">Grand Total</span>
                    <span id="summaryGrandTotal" class="text-2xl font-extrabold text-emerald-700">Rp 0</span>
                </div>
            </div>

            <button onclick="copyWhatsAppQuote()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 px-4 rounded-xl shadow-md transition flex items-center justify-center gap-2 text-base">
                <i class="fa-brands fa-whatsapp text-xl"></i> Copy Customer Quote for WhatsApp
            </button>
        </div>
    </div>

    <script>
        // CONFIGURATION & DEFAULTS
        let exchangeRate = 13.6;
        let customerBaseFee = 20000;
        let itemCount = 0;

        const weightTiers = [
            { maxWeight: 100, multiplier: 1.40, label: "0 - 100g (140%)" },
            { maxWeight: 200, multiplier: 1.375, label: "101 - 200g (137.5%)" },
            { maxWeight: 300, multiplier: 1.350, label: "201 - 300g (135%)" },
            { maxWeight: 400, multiplier: 1.325, label: "301 - 400g (132.5%)" },
            { maxWeight: 500, multiplier: 1.300, label: "401 - 500g (130%)" },
            { maxWeight: 600, multiplier: 1.275, label: "501 - 600g (127.5%)" },
            { maxWeight: 700, multiplier: 1.250, label: "601 - 700g (125%)" },
            { maxWeight: 800, multiplier: 1.200, label: "701 - 800g (120%)" },
            { maxWeight: 900, multiplier: 1.175, label: "801 - 900g (117.5%)" },
            { maxWeight: 1000, multiplier: 1.150, label: "901g - 1kg (115%)" },
            { maxWeight: Infinity, multiplier: 1.150, label: "> 1kg (115%)" }
        ];

        function getTier(weightGrams) {
            for (let tier of weightTiers) {
                if (weightGrams <= tier.maxWeight) return tier;
            }
            return weightTiers[weightTiers.length - 1];
        }

        function addItem() {
            itemCount++;
            const id = itemCount;
            const container = document.getElementById('itemsContainer');
            
            const card = document.createElement('div');
            card.id = `item-card-${id}`;
            card.className = "bg-white rounded-2xl p-5 shadow-sm border border-slate-200 space-y-4 relative transition hover:shadow-md";
            
            card.innerHTML = `
                <div class="flex justify-between items-center border-b border-slate-100 pb-3">
                    <span class="font-bold text-slate-700 flex items-center gap-2">
                        <span class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-700 text-xs flex items-center justify-center">${id}</span>
                        Item #${id}
                    </span>
                    ${id > 1 ? `<button onclick="removeItem(${id})" class="text-xs text-rose-500 hover:text-rose-700 font-semibold flex items-center gap-1"><i class="fa-solid fa-trash"></i> Remove</button>` : ''}
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="space-y-3">
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Item Description / Name</label>
                            <input type="text" id="desc-${id}" placeholder="e.g. Album / Shoes / Hoodie" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Price in Korean Won (KRW)</label>
                            <div class="relative">
                                <span class="absolute left-3 top-2.5 text-xs font-bold text-slate-400">₩</span>
                                <input type="number" id="krw-${id}" oninput="calculateOrder()" placeholder="0" class="w-full border border-slate-300 rounded-lg pl-8 pr-3 py-2 text-sm font-semibold focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                            </div>
                        </div>
                    </div>

                    <div class="space-y-3 bg-slate-50 p-3 rounded-xl border border-slate-200">
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">Actual Weight (grams)</label>
                            <input type="number" id="weight-${id}" oninput="calculateOrder()" placeholder="e.g. 350" class="w-full border border-slate-300 rounded-lg px-3 py-1.5 text-sm focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-500 mb-1">Dimensions (Length x Width x Height cm)</label>
                            <div class="grid grid-cols-3 gap-2">
                                <input type="number" id="length-${id}" oninput="calculateOrder()" placeholder="L" class="border border-slate-300 rounded-lg px-2 py-1 text-xs text-center focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                                <input type="number" id="width-${id}" oninput="calculateOrder()" placeholder="W" class="border border-slate-300 rounded-lg px-2 py-1 text-xs text-center focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                                <input type="number" id="height-${id}" oninput="calculateOrder()" placeholder="H" class="border border-slate-300 rounded-lg px-2 py-1 text-xs text-center focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                            </div>
                        </div>
                    </div>
                </div>

                <div class="bg-emerald-50/60 rounded-xl p-3 border border-emerald-100 flex flex-wrap items-center justify-between gap-2 text-xs">
                    <div class="space-y-0.5">
                        <span id="badge-${id}" class="inline-block bg-emerald-200 text-emerald-800 px-2 py-0.5 rounded font-bold">Tier: -</span>
                        <p id="billableText-${id}" class="text-slate-500">Billable Weight: 0g</p>
                    </div>
                    <div class="text-right">
                        <span class="text-slate-500 block">Item Total (IDR)</span>
                        <span id="itemTotal-${id}" class="text-base font-extrabold text-emerald-700">Rp 0</span>
                    </div>
                </div>
            `;

            container.appendChild(card);
            calculateOrder();
        }

        function removeItem(id) {
            const card = document.getElementById(`item-card-${id}`);
            if (card) card.remove();
            calculateOrder();
        }

        function calculateOrder() {
            exchangeRate = parseFloat(document.getElementById('exchangeRateInput').value) || 13.5;
            customerBaseFee = parseFloat(document.getElementById('baseFeeInput').value) || 0;

            let itemsGrandTotal = 0;
            const itemCards = document.querySelectorAll('[id^="item-card-"]');

            itemCards.forEach(card => {
                const id = card.id.replace('item-card-', '');
                const krw = parseFloat(document.getElementById(`krw-${id}`).value) || 0;
                const weight = parseFloat(document.getElementById(`weight-${id}`).value) || 0;
                const l = parseFloat(document.getElementById(`length-${id}`).value) || 0;
                const w = parseFloat(document.getElementById(`width-${id}`).value) || 0;
                const h = parseFloat(document.getElementById(`height-${id}`).value) || 0;

                const volWeight = (l * w * h / 5000) * 1000;
                const billableWeight = Math.max(weight, volWeight);
                const tier = getTier(billableWeight);

                const itemTotalIDR = Math.round(krw * tier.multiplier * exchangeRate);
                itemsGrandTotal += itemTotalIDR;

                document.getElementById(`badge-${id}`).innerText = `${tier.label}`;
                document.getElementById(`billableText-${id}`).innerText = `Billable Weight: ${Math.round(billableWeight)}g (${volWeight > weight ? 'Volumetric' : 'Actual'})`;
                document.getElementById(`itemTotal-${id}`).innerText = `Rp ${itemTotalIDR.toLocaleString('id-ID')}`;
            });

            document.getElementById('summaryItemCount').innerText = itemCards.length;
            document.getElementById('summaryItemsTotal').innerText = `Rp ${itemsGrandTotal.toLocaleString('id-ID')}`;
            document.getElementById('summaryBaseFee').innerText = `Rp ${customerBaseFee.toLocaleString('id-ID')}`;
            document.getElementById('summaryGrandTotal').innerText = `Rp ${(itemsGrandTotal + customerBaseFee).toLocaleString('id-ID')}`;
        }

        function copyWhatsAppQuote() {
            const itemCards = document.querySelectorAll('[id^="item-card-"]');
            let itemsText = "";
            let grandTotal = customerBaseFee;

            itemCards.forEach((card, index) => {
                const id = card.id.replace('item-card-', '');
                const desc = document.getElementById(`desc-${id}`).value || `Item ${index + 1}`;
                const krw = parseFloat(document.getElementById(`krw-${id}`).value) || 0;
                const weight = parseFloat(document.getElementById(`weight-${id}`).value) || 0;
                const l = parseFloat(document.getElementById(`length-${id}`).value) || 0;
                const w = parseFloat(document.getElementById(`width-${id}`).value) || 0;
                const h = parseFloat(document.assertEqual(`height-${id}`).value) || 0; // handled safely below

                const volWeight = (l * w * (parseFloat(document.getElementById(`height-${id}`).value) || 0) / 5000) * 1000;
                const billableWeight = Math.max(weight, volWeight);
                const tier = getTier(billableWeight);
                const total = Math.round(krw * tier.multiplier * exchangeRate);
                grandTotal += total;

                itemsText += `${index + 1}. *${desc}*\n   • Base Price: ₩${krw.toLocaleString('en-US')}\n   • Billable Weight: ${Math.round(billableWeight)}g (${tier.label.split(' ')[2]})\n   • Item Price: Rp ${total.toLocaleString('id-ID')}\n\n`;
            });

            const quote = `🛍️ *JASTIP KOREA QUOTATION*\n-----------------------------------\n${itemsText}📌 *Customer Base Fee:* Rp ${customerBaseFee.toLocaleString('id-ID')}\n-----------------------------------\n💰 *TOTAL ESTIMATE:* Rp ${grandTotal.toLocaleString('id-ID')}\n\n_Note: Prices are calculated based on item weight/volume brackets._`;

            navigator.clipboard.writeText(quote).then(() => {
                alert("WhatsApp quote copied to clipboard!");
            });
        }

        document.getElementById('exchangeRateInput').addEventListener('input', calculateOrder);
        document.getElementById('baseFeeInput').addEventListener('input', calculateOrder);

        // Add first item by default
        addItem();
    </script>
</body>
</html>
